#!/bin/bash
#
# Re-run a service's sign-in. Providers expire credentials on their own
# schedule, so this is routine maintenance rather than error recovery.
#
set -uo pipefail

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
MOUNT="$BIN_DIR/omarchy-cloud-mount"
# shellcheck source=omarchy-cloud-ui.sh
source "$BIN_DIR/omarchy-cloud-ui.sh"
# shellcheck source=omarchy-cloud-rclone-config.sh
source "$BIN_DIR/omarchy-cloud-rclone-config.sh"
# shellcheck source=omarchy-cloud-env.sh
source "$BIN_DIR/omarchy-cloud-env.sh"
trap hold_open EXIT

name="${1:?usage: omarchy-cloud-reconnect <service>}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-cloud"
REMOTE_FILE="$CONFIG_DIR/remotes/$name.conf"
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ && -f "$REMOTE_FILE" && ! -L "$REMOTE_FILE" ]] || {
  bad "'$name' is not managed by furmware.cloud."
  exit 1
}

# The remote may live in a container; from here on `rclone` runs there.
load_remote_record "$REMOTE_FILE" "$name"
env_bind_rclone "$RECORD_ENV_KIND" "$RECORD_ENV_NAME" "$RECORD_ENV_USER"
env_text="$(env_label "$RECORD_ENV_KIND" "$RECORD_ENV_NAME")"
remote="$RECORD_REMOTE"

if [[ "$RECORD_ENV_KIND" != host ]]; then
  env_running "$RECORD_ENV_KIND" "$RECORD_ENV_NAME" || env_start "$RECORD_ENV_KIND" "$RECORD_ENV_NAME" || {
    bad "$env_text is not running and could not be started."
    exit 1
  }
fi

remote_type="$(rclone config show "$remote" 2>/dev/null | awk -F' = ' '/^type/ {print $2; exit}')"
[[ -n "$remote_type" ]] || { bad "No connected service called '$remote' in $env_text."; exit 1; }

uses_oauth() {
  case "$1" in
    drive|dropbox|onedrive|box|pcloud|yandex|jottacloud) return 0 ;;
    *) return 1 ;;
  esac
}

obscure() {
  rclone obscure - <<<"$1"
}

title "Sign in to $RECORD_LABEL"
[[ "$RECORD_ENV_KIND" == host ]] || say "The sign-in is stored inside $env_text."
if [[ "$remote_type" == "iclouddrive" ]]; then
  echo "Apple will send a verification prompt to a trusted device."
  echo "Enter the 2FA code here when rclone asks for it."
elif [[ "$remote_type" == "protondrive" ]]; then
  echo "Enter your Proton password again, and a fresh 2FA code if enabled."
elif [[ "$remote_type" == "webdav" ]]; then
  echo "Enter the password (or app password) for this WebDAV account again."
elif uses_oauth "$remote_type"; then
  echo "A browser window will open. Approve access, then come back here."
else
  echo "rclone will ask for this backend's connection details."
fi
echo

# Stop first so rclone cannot keep using or overwrite credentials while they
# are refreshed. Preserve whether the service should be started afterwards.
was_active=false
was_enabled=false
"$MOUNT" is-active "$name" 2>/dev/null && was_active=true
"$MOUNT" is-enabled "$name" 2>/dev/null && was_enabled=true
if ! "$MOUNT" stop "$name"; then
  bad "Could not stop the mount safely. Sign-in was not changed."
  exit 1
fi

# Password backends have nothing to "reconnect": the saved password is
# replaced. Everything is obscured over stdin, never on a command line in
# clear text.
reconnect_proton() {
  local password code obscured
  password="$(gum input --password --placeholder "Proton password")" || return 130
  [[ -n "$password" ]] || return 1
  code="$(gum input --placeholder "2FA code (blank if not enabled)")" || return 130
  obscured="$(obscure "$password")" || return 1
  unset password
  local -a args=("password=$obscured")
  [[ -n "$code" ]] && args+=("2fa=$code")
  rclone config update "$remote" "${args[@]}" --no-obscure --no-output
}

reconnect_webdav() {
  local password obscured
  password="$(gum input --password --placeholder "password / app password")" || return 130
  [[ -n "$password" ]] || return 1
  obscured="$(obscure "$password")" || return 1
  unset password
  rclone config update "$remote" "pass=$obscured" --no-obscure --no-output
}

# iCloud needs its JSON state protocol driven explicitly or rclone submits a
# blank 2FA code. OAuth has a dedicated reconnect flow; other backends revisit
# all of their connection settings.
status=0
if [[ "$remote_type" == "iclouddrive" ]]; then
  run_icloud_config "$remote" config update "$remote" || status=$?
elif [[ "$remote_type" == "protondrive" ]]; then
  reconnect_proton || status=$?
elif [[ "$remote_type" == "webdav" ]]; then
  reconnect_webdav || status=$?
elif uses_oauth "$remote_type"; then
  rclone config reconnect "$remote:" || status=$?
else
  rclone config update "$remote" --all --no-output || status=$?
fi

if ((status == 0)); then
  if [[ "$was_active" == "true" || "$was_enabled" == "true" ]]; then
    if ! "$MOUNT" start "$name"; then
      bad "Signed in, but the mount could not be started."
      exit 1
    fi
  fi
  good "Signed in."
elif ((status == 130)); then
  bad "Cancelled. The mount was left stopped and can be started from the panel."
  exit 130
else
  bad "Sign-in did not complete. The mount was left stopped."
  exit 1
fi
